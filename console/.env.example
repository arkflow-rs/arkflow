# WARNING: Vite inlines VITE_API_TOKEN into the public JavaScript bundle at
# build time — anyone who can load the console can extract this token from
# the bundle. Use it only on trusted networks; production deployments should
# use OIDC authentication instead (leave VITE_API_TOKEN unset). For
# controlled Docker builds pass it explicitly:
#   docker build --build-arg VITE_API_TOKEN=... .
#
# Must match the Hub's ARKFLOW_OPERATOR_TOKEN when operator authentication is enabled.
VITE_API_TOKEN=operator-secret
# Optional; defaults to the Vite proxy path.
# VITE_API_BASE=/api/v1
